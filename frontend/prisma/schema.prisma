// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  plan          Plan      @default(FREE)
  role          UserRole  @default(WORKSPACE)
  accounts      Account[]
  sessions      Session[]
  chatbots      Chatbot[]
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Int           // In paise (e.g. 49900 = ₹499.00)
  currency          String        @default("INR")
  plan              Plan
  status            PaymentStatus @default(PENDING)
  receipt           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Chatbot {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  businessName        String
  description         String?
  systemPrompt        String         @db.Text
  primaryColor        String         @default("#6366f1")
  welcomeMessage      String         @default("Hi! How can I help you today?")
  language            String         @default("en")
  isActive            Boolean        @default(true)
  telegramToken       String?
  privacyLevel        PrivacyLevel   @default(PII_MASKED)
  // White-label: hides "Powered by Conciergo" branding (paid add-on)
  whiteLabelEnabled   Boolean        @default(false)
  whiteLabelBrand     String?        // Custom brand name shown to end-users when white-label is on
  // Pre-chat user details form
  requireUserDetails  Boolean        @default(false)
  userDetailFields    Json?          // JSON: [{id, label, type, required}]
  documents           Document[]
  sessions            ChatSession[]
  tickets             FeedbackTicket[]
  rawExtractedTexts   RawExtractedText[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Document {
  id               String            @id @default(cuid())
  chatbotId        String
  chatbot          Chatbot           @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  name             String
  type             DocType
  content          String            @db.Text
  sourceUrl        String?
  status           DocStatus         @default(PENDING)
  chunkCount       Int               @default(0)
  rawExtractedText RawExtractedText?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model RawExtractedText {
  id           String    @id @default(cuid())
  documentId   String    @unique
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chatbotId    String
  chatbot      Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  rawText      String    @db.Text
  charCount    Int       @default(0)
  wordCount    Int       @default(0)
  sourceType   DocType   @default(TEXT)
  extractedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([chatbotId])
  @@index([documentId])
}

model ChatSession {
  id                 String     @id @default(cuid())
  chatbotId          String
  chatbot            Chatbot    @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorId          String
  language           String     @default("en")
  messages           Message[]
  metadata           Json?
  sentiment          Sentiment?
  sentimentScore     Float?
  sentimentReason    String?    @db.Text
  needsFollowUp      Boolean    @default(false)
  sentimentUpdatedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Message {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       Role
  content    String      @db.Text
  tokens     Int?
  confidence Float?
  createdAt  DateTime    @default(now())
}

model FeedbackTicket {
  id               String         @id @default(cuid())
  chatbotId        String
  chatbot          Chatbot        @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorId        String
  userEmail        String?
  category         TicketCategory @default(GENERAL_FEEDBACK)
  subject          String
  description      String         @db.Text
  attachedContext  String?        @db.Text
  status           TicketStatus   @default(OPEN)
  clientFeedback   String?        @db.Text
  escalatedToAdmin Boolean        @default(false)
  clientReviewedAt DateTime?
  adminResponse    String?        @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum PrivacyLevel {
  STANDARD
  PII_MASKED
  ZERO_RETENTION
}

enum TicketCategory {
  INACCURATE_ANSWER
  BUG_REPORT
  COMPLAINT
  FEATURE_REQUEST
  GENERAL_FEEDBACK
}

enum TicketStatus {
  OPEN
  REVIEWED_BY_CLIENT
  ESCALATED_TO_ADMIN
  IN_PROGRESS
  RECTIFIED
  RESOLVED
  CLOSED
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UserRole {
  ADMIN
  WORKSPACE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum DocType {
  FAQ
  PDF
  URL
  TEXT
  DOCX
}

enum DocStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum Role {
  USER
  ASSISTANT
}
